# 🔹 Ignore Visual Studio files
.vscode/
.vs/
*.sln
*.vcxproj*
*.user

# 🔹 Ignore Premake build files
bin/
bin-int/
*.make
*.workspace
*.ninja

# 🔹 Ignore compiled binaries
*.exe
*.dll
*.lib
*.obj
*.pdb
*.ilk
*.idb
*.ipdb
*.iobj

# 🔹 Ignore OpenCV built files (if accidentally tracked)
opencv/build/
opencv/*.lib
opencv/*.dll

# 🔹 Ignore logs and temporary files
*.log
*.tmp
*.cache
*.swp
*.bak
*.db

resources
/resource/mnist_test.csv
/resource/mnist_train.csv

# Python cache
__pycache__/
*.py[cod]

# Generated/downloaded dataset files
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Local builds
cnn

# Experiment artifacts
my_model.bin
checkpoint_epoch_*.bin
